@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Users";
    var users = Model.ToList();
}
<div class="page-header admin-page-header mb-4">
    <div>
        <h2 class="mb-0">User Accounts</h2>
    </div>
    <span class="catalog-count-badge"><i class="bi bi-people me-1"></i>@users.Count account@(users.Count == 1 ? "" : "s")</span>
</div>

<div class="card filter-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-9">
                <label class="form-label small fw-semibold text-uppercase text-muted mb-1">Search</label>
                <div class="search-field">
                    <i class="bi bi-search search-icon"></i>
                    <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by full name, email, or ID number..." aria-label="Search borrowers" />
                </div>
            </div>
            <div class="col-lg-3 d-flex gap-2 align-items-end">
                <button class="btn btn-dark flex-fill filter-action-btn"><i class="bi bi-funnel me-1"></i> Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary filter-action-btn" title="Clear filters" aria-label="Clear filters"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="card-header bg-transparent border-0 px-4 pt-4 pb-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">Registered Users</h5>
            <small class="text-muted">Showing @users.Count user(s)</small>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pro-table">
            <thead>
                <tr>
                    <th class="ps-4">User</th>
                    <th>ID Number</th>
                    <th>Email</th>
                    <th>Pending</th>
                    <th>Active</th>
                    <th>Overdue</th>
                    <th>History</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    var initials = string.IsNullOrWhiteSpace(u.FullName) ? "U" : string.Concat(u.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));
                    var statsMap = ViewBag.UserStats as System.Collections.IDictionary;
                    dynamic st = statsMap != null && statsMap.Contains(u.Id) ? statsMap[u.Id] : null;
                    int pending = st?.Pending ?? 0;
                    int active = st?.Active ?? 0;
                    int overdue = st?.Overdue ?? 0;
                    int total = st?.Total ?? 0;
                    var adminIds = ViewBag.AdminIds as HashSet<string> ?? new HashSet<string>();
                    bool isAdmin = adminIds.Contains(u.Id);
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar">@initials</div>
                                <div>
                                    <div class="fw-semibold"><a asp-action="Details" asp-route-id="@u.Id" class="text-decoration-none">@u.FullName</a></div>
                                    <small class="text-muted">@(isAdmin ? "Admin account" : "Borrower account")</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(u.IdNumber))
                            {
                                <span class="badge bg-light text-dark border">@u.IdNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-envelope text-muted"></i>
                                <span>@u.Email</span>
                            </div>
                        </td>
                        <td>@if(pending > 0){<span class="badge bg-warning text-dark">@pending</span>}else{<span>0</span>}</td>
                        <td>@active</td>
                        <td>@if(overdue > 0){<span class="text-danger fw-semibold">@overdue</span>}else{<span>0</span>}</td>
                        <td>@total</td>
                        <td class="text-end pe-4 text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@u.Id"><i class="bi bi-person-lines-fill me-1"></i>Details</a>
                            @if (!isAdmin)
                            {
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this user account?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!users.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="empty-state-icon mb-2"><i class="bi bi-people"></i></div>
                            <div class="fw-semibold">No users found</div>
                            <div class="text-muted small">Try adjusting your search criteria.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>