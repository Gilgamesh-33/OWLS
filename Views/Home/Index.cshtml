@{ ViewData["Title"] = "Home"; }
<div class="hero mb-4">
    <h1 class="display-5 fw-bold">Online Web Library System</h1>
    <p class="lead mb-4">Library transaction and catalog management for Dasmariñas Integrated High School</p>
    @if (User.Identity.IsAuthenticated)
    {
        <form asp-controller="Books" asp-action="Index" method="get" class="row g-2" style="max-width:560px">
            <div class="col"><input name="search" class="form-control form-control-lg" placeholder="Search title, author, ISBN or category..." /></div>
            <div class="col-auto"><button class="btn btn-warning btn-lg"><i class="bi bi-search"></i></button></div>
        </form>
    }
    else
    {
        <a class="btn btn-warning btn-lg me-2" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Create account</a>
    }
</div>
<div class="row g-3">
    <div class="col-md-4"><div class="card stat-card p-3 text-center"><div class="num">@ViewBag.Titles</div>Book titles</div></div>
    <div class="col-md-4"><div class="card stat-card p-3 text-center"><div class="num">@ViewBag.Available</div>Copies available</div></div>
    <div class="col-md-4"><div class="card stat-card p-3 text-center"><div class="num">@ViewBag.Active</div>Books currently borrowed</div></div>
</div>
