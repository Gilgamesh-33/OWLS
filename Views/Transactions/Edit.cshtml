@model BorrowTransaction
@{ ViewData["Title"] = "Edit Transaction"; }
<h2>Edit Transaction #@Model.Id</h2>
<div class="card p-4" style="max-width:520px">
    <p><strong>@Model.Book.Title</strong><br />Borrower: @Model.User.FullName</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="mb-3"><label class="form-label">Due date</label><input type="date" name="dueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <button class="btn btn-primary">Update</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
