@model BorrowTransaction
@{
    ViewData["Title"] = "Edit Transaction";
}
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel {
    Title = $"Edit Transaction #{Model.Id}",
    Subtitle = "Update the due date for this loan."
})
<div class="card p-4 form-narrow-sm">
    <p><strong>@Model.Book.Title</strong><br />Borrower: @Model.User.FullName</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="mb-3"><label class="form-label">Due date</label><input type="date" name="dueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="form-actions"><button class="btn btn-primary">Update</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a></div>
    </form>
</div>