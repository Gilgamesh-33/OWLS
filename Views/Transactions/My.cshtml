@model IEnumerable<BorrowTransaction>
@{
    ViewData["Title"] = "My Borrowings";
}
<div class="page-header"><h2>My Borrowing History</h2></div>
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Book</th><th>Borrowed</th><th>Due</th><th>Returned</th><th>Penalty</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Book.Title</td>
                        <td>@t.BorrowDate.ToString("MMM dd, yyyy")</td>
                        <td>@t.DueDate.ToString("MMM dd, yyyy")</td>
                        <td>@(t.ReturnDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                        <td>@(t.CurrentPenalty > 0 ? "₱" + t.CurrentPenalty.ToString("N2") : "-")</td>
                        <td><span class="badge @(t.Status == "Returned" ? "bg-secondary" : t.Status == "Overdue" ? "bg-danger" : "bg-primary")">@t.Status</span></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">You have no borrowing records yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>