@model ReportViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Reports";
    string range = (Model.Range ?? "custom").ToLowerInvariant();
    int statusTotal = Model.StatusBreakdown.Sum(x => x.Value);
    var trendLabels = JsonSerializer.Serialize(Model.BorrowTrend.Select(x => x.Label));
    var trendValues = JsonSerializer.Serialize(Model.BorrowTrend.Select(x => x.Value));
    var returnsLabels = JsonSerializer.Serialize(Model.MonthlyReturns.Select(x => x.Label));
    var returnsValues = JsonSerializer.Serialize(Model.MonthlyReturns.Select(x => x.Value));
    var topLabels = JsonSerializer.Serialize(Model.TopBooks.Select(x => x.Title));
    var topValues = JsonSerializer.Serialize(Model.TopBooks.Select(x => x.Count));
    var catLabels = JsonSerializer.Serialize(Model.InventoryByCategory.Select(x => x.Category));
    var catTotal = JsonSerializer.Serialize(Model.InventoryByCategory.Select(x => x.TotalCopies));
    var catAvail = JsonSerializer.Serialize(Model.InventoryByCategory.Select(x => x.AvailableCopies));
    var catBorrowed = JsonSerializer.Serialize(Model.InventoryByCategory.Select(x => x.BorrowedCopies));
    var availLabels = JsonSerializer.Serialize(Model.AvailabilityBreakdown.Select(x => x.Label));
    var availValues = JsonSerializer.Serialize(Model.AvailabilityBreakdown.Select(x => x.Value));
    var statusLabels = JsonSerializer.Serialize(Model.StatusBreakdown.Select(x => x.Label));
    var statusValues = JsonSerializer.Serialize(Model.StatusBreakdown.Select(x => x.Value));
}
<link rel="stylesheet" href="~/css/Reports.css" asp-append-version="true" />

<div class="report-print-page">
    <div class="report-print-header d-none d-print-block mb-3">
        <div class="report-print-head d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <img src="~/images/dihs-logo.svg" asp-append-version="true" alt="DIHS Logo" class="report-print-logo-img" />
                <div>
                    <div class="report-print-brand">OWLS &mdash; Online Web Library System</div>
                    <div class="text-muted">Dasmariñas Integrated High School</div>
                    <div class="fw-semibold">Library Management Report</div>
                </div>
            </div>
            <div class="text-end small">
                <div><strong>Reporting Period:</strong> @Model.From.ToString("MMM dd, yyyy") &ndash; @Model.To.ToString("MMM dd, yyyy")</div>
                <div><strong>Generated:</strong> @DateTime.Now.ToString("MMM dd, yyyy h:mm tt")</div>
                <div><strong>Filter:</strong> @(char.ToUpperInvariant(range[0]) + range.Substring(1))</div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_PageHeader", new PageHeaderViewModel {
        Title = "Library Reports & Analytics",
        Subtitle = "Track circulation, inventory, and overdue activity across the library.",
        Actions = @<button class="btn btn-outline-dark rp-print-btn" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print / Save PDF</button>
    })

    <div class="card rp-filter mb-4 no-print">
        <div class="card-body">
            <form method="get" id="reportFilterForm" class="rp-filter-row">
                <div class="rp-quick">
                    <span class="rp-field-label">Quick Range</span>
                    <div class="rp-range" role="group" aria-label="Quick date range">
                        <a class="btn btn-sm @(range=="daily"?"btn-primary":"btn-outline-secondary")" aria-current="@(range=="daily"?"page":null)" asp-action="Index" asp-route-range="daily">Daily</a>
                        <a class="btn btn-sm @(range=="weekly"?"btn-primary":"btn-outline-secondary")" aria-current="@(range=="weekly"?"page":null)" asp-action="Index" asp-route-range="weekly">Weekly</a>
                        <a class="btn btn-sm @(range=="monthly"?"btn-primary":"btn-outline-secondary")" aria-current="@(range=="monthly"?"page":null)" asp-action="Index" asp-route-range="monthly">Monthly</a>
                        <a class="btn btn-sm @(range=="yearly"?"btn-primary":"btn-outline-secondary")" aria-current="@(range=="yearly"?"page":null)" asp-action="Index" asp-route-range="yearly">Yearly</a>
                        <button type="button" class="btn btn-sm @(range=="custom"?"btn-primary":"btn-outline-secondary")" id="customRangeBtn" aria-pressed="@(range=="custom"?"true":"false")">Custom</button>
                    </div>
                </div>
                <input type="hidden" name="range" id="rangeInput" value="@range" />
                <div>
                    <label for="fromInput" class="rp-field-label">From</label>
                    <div class="rp-date-field">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <input type="date" name="from" id="fromInput" value="@Model.From.ToString("yyyy-MM-dd")" class="rp-date-input" />
                    </div>
                </div>
                <div>
                    <label for="toInput" class="rp-field-label">To</label>
                    <div class="rp-date-field">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <input type="date" name="to" id="toInput" value="@Model.To.ToString("yyyy-MM-dd")" class="rp-date-input" />
                    </div>
                </div>
                <div>
                    <button class="btn btn-primary rp-refresh" title="Refresh report" aria-label="Refresh report"><i class="bi bi-arrow-repeat"></i><span class="d-lg-none ms-1">Refresh</span></button>
                </div>
            </form>
        </div>
    </div>

    <div class="rp-period">
        <i class="bi bi-calendar-range" aria-hidden="true"></i>
        <span><strong>Reporting period</strong> @Model.From.ToString("MMM dd, yyyy") &ndash; @Model.To.ToString("MMM dd, yyyy")</span>
        <span class="no-print">&middot; Charts update automatically from database records.</span>
    </div>

    <!-- ===== Primary KPIs ===== -->
    <div class="row g-3 rp-kpis rp-kpis--primary mb-3">
        <div class="col-12 col-md-4 report-print-block">
            <article class="rp-kpi rp-kpi--primary rp-kpi--books h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-journal-arrow-up"></i></span>
                    <span class="rp-kpi-label">Books Borrowed</span>
                </div>
                <div class="rp-kpi-value">@Model.TotalBorrowed</div>
                <p class="rp-kpi-meta">Approved loans in period</p>
            </article>
        </div>
        <div class="col-12 col-md-4 report-print-block">
            <article class="rp-kpi rp-kpi--primary rp-kpi--pending h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                    <span class="rp-kpi-label">Pending Requests</span>
                </div>
                <div class="rp-kpi-value">@Model.PendingRequests</div>
                <p class="rp-kpi-meta">Awaiting approval</p>
            </article>
        </div>
        <div class="col-12 col-md-4 report-print-block">
            <article class="rp-kpi rp-kpi--primary rp-kpi--due h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-calendar2-x"></i></span>
                    <span class="rp-kpi-label">Due / Overdue</span>
                </div>
                <div class="rp-kpi-value">@Model.OverdueCount</div>
                <p class="rp-kpi-meta">Active loans past their due date</p>
            </article>
        </div>
    </div>

    <!-- ===== Secondary KPIs ===== -->
    <div class="row g-3 rp-kpis rp-kpis--secondary mb-4">
        <div class="col-12 col-sm-6 col-lg-3 report-print-block">
            <article class="rp-kpi rp-kpi--secondary rp-kpi--inventory h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-collection"></i></span>
                    <span class="rp-kpi-label">Total Inventory</span>
                </div>
                <div class="rp-kpi-value">@Model.TotalCopies</div>
                <p class="rp-kpi-meta">@Model.TotalTitles titles &middot; @Model.AvailableCopies available</p>
            </article>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 report-print-block">
            <article class="rp-kpi rp-kpi--secondary rp-kpi--active h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-journal-check"></i></span>
                    <span class="rp-kpi-label">Active Loans</span>
                </div>
                <div class="rp-kpi-value">@Model.ActiveLoans</div>
                <p class="rp-kpi-meta">Currently borrowed</p>
            </article>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 report-print-block">
            <article class="rp-kpi rp-kpi--secondary rp-kpi--penalties h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-cash-coin"></i></span>
                    <span class="rp-kpi-label">Penalties (Period)</span>
                </div>
                <div class="rp-kpi-value">₱@Model.TotalPenalties.ToString("N2")</div>
                <p class="rp-kpi-meta">From returns in period</p>
            </article>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 report-print-block">
            <article class="rp-kpi rp-kpi--secondary rp-kpi--declined h-100">
                <div class="rp-kpi-top">
                    <span class="rp-kpi-icon" aria-hidden="true"><i class="bi bi-x-circle"></i></span>
                    <span class="rp-kpi-label">Declined Requests</span>
                </div>
                <div class="rp-kpi-value">@Model.DeclinedRequests</div>
                <p class="rp-kpi-meta">Total declined requests</p>
            </article>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Monthly Borrowing Trends</h5>
                        <p class="rp-card-sub">Approved borrowing activity over the selected period</p>
                    </div>
                    <div class="rp-chart rp-chart--lg report-chart-wrap"><canvas id="trendChart" role="img" aria-label="Line chart of books borrowed over the selected period"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-5 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Borrowing Status Breakdown</h5>
                        <p class="rp-card-sub">Pending, approved (active), returned, overdue, declined</p>
                    </div>
                    <div class="rp-chart rp-chart--sm report-chart-wrap"><canvas id="statusChart" role="img" aria-label="Doughnut chart of borrowing status breakdown, @statusTotal total records"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Top Borrowed Books</h5>
                        <p class="rp-card-sub">Detailed counts for the reporting period</p>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 pro-table rp-table">
                            <thead><tr><th class="ps-3">Title</th><th class="text-end pe-3">Times Borrowed</th></tr></thead>
                            <tbody>
                                @foreach (var b in Model.TopBooks)
                                {
                                    <tr><td class="ps-3">@b.Title</td><td class="text-end pe-3 fw-semibold">@b.Count</td></tr>
                                }
                                @if (!Model.TopBooks.Any())
                                {
                                    <tr><td colspan="2"><div class="rp-empty"><span>No data for this period.</span></div></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Inventory Summary by Category</h5>
                        <p class="rp-card-sub">Current stock distribution</p>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 pro-table rp-table">
                            <thead><tr><th class="ps-3">Category</th><th class="text-end">Total</th><th class="text-end">Available</th><th class="text-end pe-3">Borrowed</th></tr></thead>
                            <tbody>
                                @foreach (var c in Model.InventoryByCategory)
                                {
                                    <tr><td class="ps-3">@c.Category</td><td class="text-end">@c.TotalCopies</td><td class="text-end">@c.AvailableCopies</td><td class="text-end pe-3">@c.BorrowedCopies</td></tr>
                                }
                                @if (!Model.InventoryByCategory.Any())
                                {
                                    <tr><td colspan="4"><div class="rp-empty"><span>No inventory data.</span></div></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Most Borrowed Books</h5>
                        <p class="rp-card-sub">Top requested titles in the selected period</p>
                    </div>
                    <div class="rp-chart rp-chart--md report-chart-wrap"><canvas id="topBooksChart" role="img" aria-label="Horizontal bar chart of most borrowed books"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-6 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Monthly Book Returns</h5>
                        <p class="rp-card-sub">Returned books over the selected period</p>
                    </div>
                    <div class="rp-chart rp-chart--md report-chart-wrap"><canvas id="returnsChart" role="img" aria-label="Bar chart of books returned over the selected period"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Available vs Borrowed Books</h5>
                        <p class="rp-card-sub">Current copy distribution across all titles</p>
                    </div>
                    <div class="rp-chart rp-chart--md report-chart-wrap"><canvas id="availabilityChart" role="img" aria-label="Doughnut chart of available versus borrowed copies"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 report-print-block">
            <div class="card table-card h-100 rp-card">
                <div class="card-body">
                    <div class="rp-card-head">
                        <h5 class="rp-card-title">Book Inventory Distribution by Category</h5>
                        <p class="rp-card-sub">Total, available, and borrowed copies per category</p>
                    </div>
                    <div class="rp-chart rp-chart--lg report-chart-wrap"><canvas id="inventoryChart" role="img" aria-label="Grouped bar chart of inventory by category"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card table-card rp-card rp-overdue report-print-block mb-4">
        <div class="card-body">
            <div class="rp-card-head d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div>
                    <h5 class="rp-card-title">Overdue Log</h5>
                    <p class="rp-card-sub">Currently overdue approved loans (real-time)</p>
                </div>
                <span class="rp-count" aria-label="@Model.OverdueLog.Count overdue loans">@Model.OverdueLog.Count overdue</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 pro-table rp-table">
                    <thead><tr><th class="ps-3">Book</th><th>Borrower</th><th>ID No.</th><th>Due Date</th><th class="text-end pe-3">Current Penalty</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.OverdueLog)
                        {
                            <tr>
                                <td class="ps-3">@t.Book?.Title</td>
                                <td>@t.User?.FullName</td>
                                <td>@t.User?.IdNumber</td>
                                <td>@t.DueDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-3 fw-semibold text-danger">₱@t.CurrentPenalty.ToString("N2")</td>
                            </tr>
                        }
                        @if (!Model.OverdueLog.Any())
                        {
                            <tr><td colspan="5"><div class="rp-empty"><i class="bi bi-check-circle" aria-hidden="true"></i><span>No overdue books at the moment.</span></div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="report-print-footer d-none d-print-block">
        <div class="d-flex justify-content-between align-items-center small text-muted">
            <span>OWLS &mdash; Online Web Library System, Dasmariñas Integrated High School</span>
            <span>Report Period: @Model.From.ToString("MMM dd, yyyy") &ndash; @Model.To.ToString("MMM dd, yyyy")</span>
            <span class="report-page-number"></span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const customBtn = document.getElementById('customRangeBtn');
            const rangeInput = document.getElementById('rangeInput');
            const markCustom = function () {
                if (rangeInput) rangeInput.value = 'custom';
                if (customBtn) customBtn.setAttribute('aria-pressed', 'true');
            };
            if (customBtn && rangeInput) customBtn.addEventListener('click', markCustom);
            ['fromInput', 'toInput'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('change', markCustom);
            });

            const tone = { primary: '#2d452f', secondary: '#6f8b6d', light: '#cfe2ce', alert: '#b23b48', warning: '#b27a24', neutral: '#9aa69a' };
            const common = {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                devicePixelRatio: 2,
                color: '#6c7a6c',
                font: { family: 'Roboto, system-ui, sans-serif', size: 11 },
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false, labels: { boxWidth: 9, boxHeight: 9, usePointStyle: true, pointStyle: 'circle', padding: 14, color: '#4c5f4e', font: { size: 11 } } },
                    tooltip: { backgroundColor: '#263a28', padding: 10, cornerRadius: 8, usePointStyle: true, boxWidth: 8, boxHeight: 8, titleFont: { size: 12, weight: '600' }, bodyFont: { size: 12 } }
                },
                scales: {
                    x: { grid: { display: false }, border: { display: false }, ticks: { color: '#7c8a7d', maxRotation: 45, minRotation: 0, maxTicksLimit: 14 } },
                    y: { beginAtZero: true, border: { display: false }, grid: { color: 'rgba(45,69,47,.08)', drawTicks: false }, ticks: { color: '#7c8a7d', precision: 0, padding: 8 } }
                }
            };
            const legendTop = { ...common, plugins: { ...common.plugins, legend: { ...common.plugins.legend, display: true, position: 'top' } } };
            const donut = {
                ...common,
                scales: {},
                cutout: '62%',
                interaction: { mode: 'nearest', intersect: true },
                plugins: { ...common.plugins, legend: { ...common.plugins.legend, display: true, position: 'bottom' } }
            };
            const bar = function (label, data, color) {
                return { label: label, data: data, backgroundColor: color, borderRadius: 5, borderSkipped: false, maxBarThickness: 26 };
            };

            const trendLabels = @Html.Raw(trendLabels), trendValues = @Html.Raw(trendValues);
            const returnsLabels = @Html.Raw(returnsLabels), returnsValues = @Html.Raw(returnsValues);
            const topLabels = @Html.Raw(topLabels), topValues = @Html.Raw(topValues);
            const catLabels = @Html.Raw(catLabels), catTotal = @Html.Raw(catTotal), catAvail = @Html.Raw(catAvail), catBorrowed = @Html.Raw(catBorrowed);
            const availLabels = @Html.Raw(availLabels), availValues = @Html.Raw(availValues);
            const statusLabels = @Html.Raw(statusLabels), statusValues = @Html.Raw(statusValues);
            const statusTotal = @statusTotal;

            const mk = (id, cfg) => { const el = document.getElementById(id); if (el && typeof Chart !== 'undefined') new Chart(el, cfg); };

            mk('trendChart', {
                type: 'line',
                data: { labels: trendLabels, datasets: [{
                    label: 'Books Borrowed', data: trendValues,
                    borderColor: tone.primary, backgroundColor: 'rgba(45,69,47,.10)',
                    borderWidth: 2, fill: true, tension: .35,
                    pointRadius: 2.5, pointHoverRadius: 5, pointBackgroundColor: tone.primary, pointBorderWidth: 0
                }] },
                options: common
            });

            mk('statusChart', {
                type: 'doughnut',
                data: { labels: statusLabels, datasets: [{
                    label: 'Count', data: statusValues,
                    backgroundColor: [tone.warning, tone.secondary, tone.primary, tone.alert, tone.neutral], borderWidth: 0, hoverOffset: 4
                }] },
                options: { ...donut, cutout: '60%' },
                plugins: [{
                    id: 'rpCenterTotal',
                    beforeDraw: function (chart) {
                        const area = chart.chartArea;
                        if (!area) return;
                        const ctx = chart.ctx;
                        const styles = getComputedStyle(chart.canvas);
                        const ink = styles.getPropertyValue('--rp-ink').trim() || '#2d452f';
                        const muted = styles.getPropertyValue('--rp-muted').trim() || '#6c7a6c';
                        const x = (area.left + area.right) / 2;
                        const y = (area.top + area.bottom) / 2;
                        ctx.save();
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillStyle = ink;
                        ctx.font = '700 22px Roboto, system-ui, sans-serif';
                        ctx.fillText(String(statusTotal), x, y - 6);
                        ctx.fillStyle = muted;
                        ctx.font = '600 10px Roboto, system-ui, sans-serif';
                        ctx.fillText('TOTAL RECORDS', x, y + 14);
                        ctx.restore();
                    }
                }]
            });

            mk('topBooksChart', {
                type: 'bar',
                data: { labels: topLabels, datasets: [bar('Times Borrowed', topValues, tone.primary)] },
                options: {
                    ...common,
                    indexAxis: 'y',
                    plugins: { ...common.plugins, legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, border: { display: false }, grid: { color: 'rgba(45,69,47,.08)' }, ticks: { color: '#7c8a7d', precision: 0, padding: 8 } },
                        y: { grid: { display: false }, border: { display: false }, ticks: { color: '#4c5f4e', autoSkip: false } }
                    }
                }
            });

            mk('returnsChart', {
                type: 'bar',
                data: { labels: returnsLabels, datasets: [bar('Books Returned', returnsValues, tone.secondary)] },
                options: common
            });

            mk('inventoryChart', {
                type: 'bar',
                data: { labels: catLabels, datasets: [
                    bar('Total Copies', catTotal, tone.primary),
                    bar('Available', catAvail, tone.secondary),
                    bar('Borrowed', catBorrowed, tone.warning)
                ] },
                options: legendTop
            });

            mk('availabilityChart', {
                type: 'doughnut',
                data: { labels: availLabels, datasets: [{ label: 'Copies', data: availValues, backgroundColor: [tone.secondary, tone.warning], borderWidth: 0, hoverOffset: 4 }] },
                options: donut
            });
        })();
    </script>
}
