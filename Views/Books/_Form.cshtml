@model Book
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="form-section mb-4">
            <div class="form-section-header">
                <div class="form-section-icon"><i class="bi bi-book"></i></div>
                <div>
                    <h5 class="mb-0">Book Information</h5>
                    <small class="text-muted">Core details used to identify and organize this title.</small>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter book title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Author" class="form-label fw-semibold"></label>
                    <input asp-for="Author" class="form-control" placeholder="Author name" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ISBN" class="form-label fw-semibold"></label>
                    <input asp-for="ISBN" class="form-control" placeholder="ISBN" />
                    <span asp-validation-for="ISBN" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" list="cats" placeholder="Select or type a category" />
                    <datalist id="cats">
                        <option>Fiction</option>
                        <option>Science</option>
                        <option>Technology</option>
                        <option>Filipino Literature</option>
                        <option>History</option>
                        <option>Mathematics</option>
                    </datalist>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                <div class="col-md-3 col-6">
                    <label asp-for="YearPublished" class="form-label fw-semibold"></label>
                    <input asp-for="YearPublished" class="form-control" placeholder="Year" />
                    <span asp-validation-for="YearPublished" class="text-danger small"></span>
                </div>
                <div class="col-md-3 col-6">
                    <label asp-for="TotalCopies" class="form-label fw-semibold"></label>
                    <input asp-for="TotalCopies" class="form-control" placeholder="Copies" />
                    <span asp-validation-for="TotalCopies" class="text-danger small"></span>
                    <div class="form-text">Available copies are managed automatically based on borrowing activity.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="form-section h-100">
            <div class="form-section-header">
                <div class="form-section-icon"><i class="bi bi-image"></i></div>
                <div>
                    <h5 class="mb-0">Cover Image</h5>
                    <small class="text-muted">Optional visual cover for the catalog.</small>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.CoverImagePath))
            {
                <div class="cover-preview-wrap mb-3">
                    <img src="@Model.CoverImagePath" alt="Current cover" class="cover-preview-img" />
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="removeCover" name="removeCover" value="true" />
                    <label class="form-check-label" for="removeCover">Remove current cover</label>
                </div>
            }
            else
            {
                <div class="cover-placeholder mb-3">
                    <i class="bi bi-image"></i>
                    <span>No cover uploaded</span>
                </div>
            }

            <label class="form-label fw-semibold">Upload Cover</label>
            <input type="file" name="coverFile" id="coverFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <div class="form-text mt-2">JPG, PNG or WEBP, up to 2 MB. Portrait (2:3) images look best.</div>
            <div class="mt-3 d-none" id="newCoverPreviewWrap">
                <div class="small text-muted mb-1">New cover preview</div>
                <img id="newCoverPreview" class="cover-preview-img" alt="New cover preview" />
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('coverFile');
        var wrap = document.getElementById('newCoverPreviewWrap');
        var img = document.getElementById('newCoverPreview');
        if (!input || !wrap || !img) return;
        input.addEventListener('change', function () {
            var file = this.files && this.files[0];
            if (!file) { wrap.classList.add('d-none'); img.src = ''; return; }
            var reader = new FileReader();
            reader.onload = function (e) {
                img.src = e.target.result;
                wrap.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        });
    })();
</script>