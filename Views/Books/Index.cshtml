@model IEnumerable<Book>
@{ ViewData["Title"] = "Catalog"; bool admin = User.IsInRole("Admin"); }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Book Catalog</h2>
    @if (admin) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Book</a> }
</div>
<form method="get" class="card p-3 mb-3 no-print">
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label small">Search</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Title, author, ISBN..." /></div>
        <div class="col-md-3"><label class="form-label small">Category</label>
            <select name="category" class="form-select">
                <option value="">All categories</option>
                @foreach (var c in (List<string>)ViewBag.Categories) { <option value="@c" selected="@(c == ViewBag.Category)">@c</option> }
            </select></div>
        <div class="col-md-2"><label class="form-label small">Sort by</label>
            <select name="sort" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Sort))">Title A-Z</option>
                <option value="title_desc" selected="@(ViewBag.Sort == "title_desc")">Title Z-A</option>
                <option value="author" selected="@(ViewBag.Sort == "author")">Author</option>
                <option value="year" selected="@(ViewBag.Sort == "year")">Newest</option>
            </select></div>
        <div class="col-md-2"><div class="form-check"><input type="checkbox" class="form-check-input" id="av" name="availableOnly" value="true" checked="@ViewBag.AvailableOnly" /><label class="form-check-label small" for="av">Available only</label></div></div>
        <div class="col-md-1"><button class="btn btn-dark w-100"><i class="bi bi-search"></i></button></div>
    </div>
</form>
<div class="card"><div class="table-responsive">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
            @foreach (var b in Model)
            {
                <div class="col">
                    <div class="card h-100 book-card">
                        <a asp-action="Details" asp-route-id="@b.Id">
                            @if (!string.IsNullOrEmpty(b.CoverImagePath))
                            {
                                <img src="@b.CoverImagePath" class="book-cover" alt="@b.Title" />
                            }
                            else
                            {

                                <div class="book-cover book-cover-empty"><i class="bi bi-book"></i></div>
                            }
                        </a>
                        <div class="card-body p-2">
                            <a asp-action="Details" asp-route-id="@b.Id" class="fw-semibold text-decoration-none d-block">@b.Title</a>
                            <div class="small text-muted">@b.Author</div>
                            <div class="small text-muted mb-1">@b.Category</div>
                            @if (b.AvailableCopies > 0)
                            {
                                <span class="badge bg-success">@b.AvailableCopies / @b.TotalCopies available</span>
                            }
                            else
                            {

                                <span class="badge bg-danger">Unavailable</span>
                            }
                        </div>
                        @if (admin)
                        {
                            <div class="card-footer bg-white p-2 no-print">
                                <a class="btn btn-sm btn-success @(b.AvailableCopies < 1 ? "disabled" : "")" asp-controller="Transactions" asp-action="Create" asp-route-bookId="@b.Id">Borrow</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.Id">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">No books found.</div>
        }
</div>
