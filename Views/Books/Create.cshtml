@model Book
@{
    ViewData["Title"] = "Add Book";
}
<div class="page-header"><h2>Add Book</h2></div>
<div class="card p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <partial name="_Form" model="Model" />
        <div class="form-actions"><button class="btn btn-primary">Save</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a></div>
    </form>
</div>