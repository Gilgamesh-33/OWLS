@model Book
@{
    ViewData["Title"] = Model.Title;
}
<div class="card p-4">
    <div class="row g-4">
        <div class="col-md-3">
            <div class="book-detail-cover">
                @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                {
                    <img src="@Model.CoverImagePath" class="book-cover" alt="@Model.Title" />
                }
                else
                {

                    <div class="book-cover book-cover-empty"><i class="bi bi-book"></i></div>
                }
            </div>
        </div>
        <div class="col-md-9">
            <h2 class="mb-3">@Model.Title</h2>
            <dl class="row mb-0 detail-list">
                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9">@Model.Author</dd>
                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category</dd>
                <dt class="col-sm-3">ISBN</dt>
                <dd class="col-sm-9">@Model.ISBN</dd>
                <dt class="col-sm-3">Year Published</dt>
                <dd class="col-sm-9">@Model.YearPublished</dd>
                <dt class="col-sm-3">Availability</dt>
                <dd class="col-sm-9">@Model.AvailableCopies of @Model.TotalCopies copies available</dd>
            </dl>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <a class="btn btn-secondary" asp-action="Index">Back to catalog</a>
                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                {
                    var pending = (ViewBag.IsPending as bool?) == true;
                    var borrowed = (ViewBag.IsBorrowed as bool?) == true;
                    if (pending)
                    {
                        <button class="btn btn-warning text-dark" disabled><i class="bi bi-hourglass-split me-1"></i>Request Pending</button>
                    }
                    else if (borrowed)
                    {
                        <button class="btn btn-secondary" disabled><i class="bi bi-journal-check me-1"></i>Currently Borrowed</button>
                    }
                    else
                    {
                        <form asp-controller="Transactions" asp-action="RequestBorrow" asp-route-bookId="@Model.Id" method="post" class="m-0 borrow-request-form d-inline" data-book-title="@Model.Title">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnTo" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                            <button type="submit" class="btn btn-primary" @(Model.AvailableCopies < 1 ? "disabled" : null)><i class="bi bi-bookmark-plus me-1"></i>Request to Borrow</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>

