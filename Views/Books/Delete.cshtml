@model Book
@{
    ViewData["Title"] = "Delete Book";
}
<div class="card p-4 border-danger confirm-danger form-narrow">
    <h3 class="text-danger">Delete this book?</h3>
    <p><strong>@Model.Title</strong> by @Model.Author (@Model.ISBN)</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions"><button class="btn btn-danger">Yes, delete</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a></div>
    </form>
</div>