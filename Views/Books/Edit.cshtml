@model Book
@{
    ViewData["Title"] = "Edit Book";
}
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel {
    Title = "Edit Book",
    Subtitle = "Update book information, inventory, and cover image.",
    Actions = @<a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i> Back to Catalog</a>
})

<div class="card form-card-pro">
    <div class="card-body p-4 p-lg-5">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <hr class="my-4" />
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Update Book</button>
            </div>
        </form>
    </div>
</div>