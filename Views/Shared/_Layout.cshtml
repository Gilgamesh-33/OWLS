@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var fullWidth = ViewData["FullWidth"] as bool? ?? false;
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeafyBooks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header class="lb-nav no-print">
        <div class="lb-nav-inner">
            <a class="lb-brand" asp-controller="Home" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                </svg>
                LeafyBooks
            </a>

            <button class="lb-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#lbNav"
                    aria-controls="lbNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-3"></i>
            </button>

            <div class="lb-nav-collapse collapse" id="lbNav">
                <ul class="lb-links">
                    <li><a asp-controller="Home" asp-action="Index" class="@Active("Home")">Home</a></li>
                    <li><a asp-controller="Books" asp-action="Index" class="@Active("Books")">Catalog</a></li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a asp-controller="Transactions" asp-action="Index" class="@Active("Transactions")">Transactions</a></li>
                            <li><a asp-controller="Users" asp-action="Index" class="@Active("Users")">Users</a></li>
                            <li><a asp-controller="Reports" asp-action="Index" class="@Active("Reports")">Reports</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Transactions" asp-action="My" class="@Active("Transactions")">My Borrowings</a></li>
                        }
                    }
                    else
                    {
                        <li><a asp-controller="Account" asp-action="Register" class="@Active("Account")">Membership</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="story">Our Story</a></li>
                    }
                </ul>

                <div class="lb-nav-actions">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="lb-user"><i class="bi bi-person-circle"></i> @User.Identity.Name @(User.IsInRole("Admin") ? "(Admin)" : "")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="lb-btn lb-btn-filled lb-btn-nav">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="lb-btn lb-btn-filled lb-btn-nav" asp-controller="Books" asp-action="Index">Borrow Now</a>
                    }
                </div>
            </div>
        </div>
    </header>

    @if (fullWidth)
    {
        <div class="container mt-3 no-print">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
        </div>
        <main class="flex-grow-1">
            @RenderBody()
        </main>
    }
    else
    {
        <main class="container lb-main flex-grow-1">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show no-print">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show no-print">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    }

    <footer class="lb-footer no-print">
        &copy; @DateTime.Now.Year LeafyBooks &middot; Online Web Library System &middot; Dasmariñas Integrated High School | Cabayao Gabito Hizo Joson
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>