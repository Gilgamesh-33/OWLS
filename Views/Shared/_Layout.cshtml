@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var fullWidth = ViewData["FullWidth"] as bool? ?? false;
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
    var displayRole = User.IsInRole("Admin") ? "Librarian" : "Borrower";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OWLS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a href="#main-content" class="visually-hidden-focusable position-absolute top-0 start-0 m-2 px-3 py-2 bg-white border rounded shadow-sm" style="z-index:2000;color:var(--lb-dark);">Skip to main content</a>

    <header class="lb-nav no-print">
        <div class="container-fluid lb-nav-inner">
            <a class="lb-brand" asp-controller="Home" asp-action="Index" aria-label="OWLS home">
                <span class="lb-brand-mark"><i class="bi bi-book-half"></i></span>
                <span class="lb-brand-text">OWLS</span>
            </a>

            <button class="lb-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-4"></i>
            </button>

            <div class="collapse d-md-flex lb-nav-collapse" id="navMain">
                <nav class="lb-nav-primary" aria-label="Primary">
                    <ul class="lb-links">
                        @if (!User.Identity.IsAuthenticated || User.IsInRole("Borrower"))
                        {
                            <li><a asp-controller="Home" asp-action="Index" class="@Active("Home")">Home</a></li>
                            <li><a asp-controller="Books" asp-action="Index" class="@Active("Books")">Catalog</a></li>
                            @if (User.IsInRole("Borrower"))
                            {
                                <li><a asp-controller="Transactions" asp-action="Borrow" class="@Active("Transactions")">Borrow Books</a></li>
                            }
                            @if (!User.Identity.IsAuthenticated)
                            {
                                <li><a asp-controller="Home" asp-action="Membership">Membership</a></li>
                                <li><a asp-controller="Home" asp-action="OurStory">Our Story</a></li>
                            }
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a asp-controller="Books" asp-action="Index" class="@Active("Books")">Catalog</a></li>
                            <li><a asp-controller="Transactions" asp-action="Index" class="@Active("Transactions")">Transactions</a></li>
                            <li><a asp-controller="Users" asp-action="Index" class="@Active("Users")">Borrowers</a></li>
                            <li><a asp-controller="Reports" asp-action="Index" class="@Active("Reports")">Reports</a></li>
                        }
                    </ul>
                </nav>

                <div class="lb-nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="lb-user-display" title="@displayName">
                            <span class="lb-user-avatar" aria-hidden="true">@initials</span>
                            <span class="lb-user-text">
                                <span class="lb-user-name">@displayName</span>
                                <span class="lb-user-role">@displayRole</span>
                            </span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 lb-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="lb-btn lb-btn-outline lb-btn-nav lb-logout-btn" aria-label="Log out">
                                <i class="bi bi-box-arrow-right"></i><span class="d-none d-lg-inline ms-1">Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="lb-btn lb-btn-outline lb-btn-nav" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="lb-btn lb-btn-filled lb-btn-nav" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </div>
            </div>
        </div>
    </header>

    @if (fullWidth)
    {
        <div class="container mt-3 no-print">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
        </div>
        <main id="main-content" class="flex-grow-1">
            @RenderBody()
        </main>
    }
    else
    {
        <main id="main-content" class="container lb-main flex-grow-1">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show no-print" role="status">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            }
            @RenderBody()
        </main>
    }

    <footer class="lb-footer no-print">
        &copy; @DateTime.Now.Year Online Web Library System &middot; Dasmariñas Integrated High School | Cabayao Gabito Hizo Joson
    </footer>

    <div class="modal fade" id="borrowConfirmModal" tabindex="-1" aria-labelledby="borrowConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem; overflow: hidden;">
                <div class="modal-header border-0 pb-0" style="background: var(--lb-surface);">
                    <h5 class="modal-title fw-bold" id="borrowConfirmModalLabel" style="color: var(--lb-dark);"><i class="bi bi-bookmark-plus me-2"></i>Confirm Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-3">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;background:var(--lb-chip);color:var(--lb-dark);"><i class="bi bi-journal-text fs-5"></i></div>
                        <div>
                            <div class="fw-semibold mb-1" id="borrowConfirmBookTitle">Request to borrow this book?</div>
                            <div class="text-muted small">Your request will be submitted as <strong>Pending</strong> for librarian approval. You can track its status in Borrow Books.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="borrowConfirmSubmitBtn"><i class="bi bi-check-lg me-1"></i>Submit Request</button>
                </div>
            </div>
        </div>
    </div>

    <script>
            // Back/Forward button: never show a stale cached page (e.g. the login page after signing in).
            // Reloading makes the server re-check the session, so signed-in users get redirected home.
            window.addEventListener('pageshow', function (e) {
                var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
                if (e.persisted || (nav && nav.type === 'back_forward')) { location.reload(); }
            });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
            (function () {
                var pendingForm = null;
                var modalEl = document.getElementById('borrowConfirmModal');
                if (!modalEl || typeof bootstrap === 'undefined') return;
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                var titleEl = document.getElementById('borrowConfirmBookTitle');
                var submitBtn = document.getElementById('borrowConfirmSubmitBtn');

                document.addEventListener('submit', function (e) {
                    var form = e.target;
                    if (!form || !form.classList || !form.classList.contains('borrow-request-form')) return;
                    if (form.dataset.confirmed === 'true') {
                        form.dataset.confirmed = 'false';
                        return;
                    }
                    e.preventDefault();
                    pendingForm = form;
                    var bookTitle = form.getAttribute('data-book-title');
                    if (titleEl) titleEl.textContent = bookTitle ? ('Request to borrow "' + bookTitle + '"?') : 'Request to borrow this book?';
                    modal.show();
                }, true);

                if (submitBtn) {
                    submitBtn.addEventListener('click', function () {
                        if (!pendingForm) return;
                        var f = pendingForm;
                        pendingForm = null;
                        f.dataset.confirmed = 'true';
                        modal.hide();
                        if (typeof f.requestSubmit === 'function') f.requestSubmit();
                        else f.submit();
                    });
                }

                modalEl.addEventListener('hidden.bs.modal', function () { pendingForm = null; });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>