<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OWLS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark owls-nav no-print">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="bi bi-book-half"></i> OWLS</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Catalog</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Transactions" asp-action="My">My Borrowings</a></li>
                    }
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item text-light me-3 small"><i class="bi bi-person-circle"></i> @User.Identity.Name @(User.IsInRole("Admin") ? "(Admin)" : "")</li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Logout</button></form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4 flex-grow-1">
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show no-print">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show no-print">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>

<footer class="text-center text-muted small py-3 border-top no-print">
    &copy; @DateTime.Now.Year Online Web Library System &middot; Dasmariñas Integrated High School | Cabayao Gabito Hizo Joson
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
